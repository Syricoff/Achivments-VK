datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum Frequency {
  ONCE
  DAILY
}

enum TaskType {
  SCREENSHOT
  QR
  MANUAL
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  PENDING_PICKUP
  DELIVERED
  CANCELLED
}

model User {
  id              Int          @id @default(autoincrement())
  vkId            BigInt       @unique @map("vk_id")
  firstName       String       @default("") @map("first_name")
  lastName        String       @default("") @map("last_name")
  avatarUrl       String?      @map("avatar_url")
  role            Role         @default(USER)
  ratingPoints    Int          @default(0) @map("rating_points")
  spendablePoints Int          @default(0) @map("spendable_points")
  createdAt       DateTime     @default(now()) @map("created_at")

  submissions     Submission[] @relation("UserSubmissions")
  reviewedSubmissions Submission[] @relation("AdminReviewedSubmissions")
  orders          Order[]
  usedQRCodes     QRCode[]

  @@map("users")
}

model Task {
  id               Int          @id @default(autoincrement())
  title            String
  description      String       @db.Text
  points           Int
  frequency        Frequency    @default(ONCE)
  dailyGlobalLimit Int?         @map("daily_global_limit")
  taskType         TaskType     @default(SCREENSHOT) @map("task_type")
  isActive         Boolean      @default(true) @map("is_active")
  orderNum         Int          @default(0) @map("order_num")
  createdAt        DateTime     @default(now()) @map("created_at")

  submissions      Submission[]

  @@map("tasks")
}

model Submission {
  id            Int              @id @default(autoincrement())
  userId        Int              @map("user_id")
  taskId        Int              @map("task_id")
  proofImageUrls Json            @map("proof_image_urls")
  comment       String?          @db.Text
  status        SubmissionStatus @default(PENDING)
  adminComment  String?          @map("admin_comment") @db.Text
  reviewedById  Int?             @map("reviewed_by_id")
  createdAt     DateTime         @default(now()) @map("created_at")

  user          User             @relation("UserSubmissions", fields: [userId], references: [id])
  task          Task             @relation(fields: [taskId], references: [id])
  reviewer      User?            @relation("AdminReviewedSubmissions", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([taskId])
  @@index([status])
  @@index([createdAt])
  @@map("submissions")
}

model QRCode {
  id           Int       @id @default(autoincrement())
  codeHash     String    @unique @map("code_hash")
  points       Int       @default(10)
  isUsed       Boolean   @default(false) @map("is_used")
  usedByUserId Int?      @map("used_by_user_id")
  usedAt       DateTime? @map("used_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  user         User?     @relation(fields: [usedByUserId], references: [id])

  @@map("qr_codes")
}

model ShopItem {
  id         Int       @id @default(autoincrement())
  title      String
  price      Int
  stock      Int
  maxPerUser Int?      @map("max_per_user")
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at")

  orders     Order[]

  @@map("shop_items")
}

model Order {
  id         Int         @id @default(autoincrement())
  userId     Int         @map("user_id")
  itemId     Int         @map("item_id")
  pricePaid  Int         @map("price_paid")
  pickupCode String      @unique @map("pickup_code")
  status     OrderStatus @default(PENDING_PICKUP)
  createdAt  DateTime    @default(now()) @map("created_at")

  user       User        @relation(fields: [userId], references: [id])
  item       ShopItem    @relation(fields: [itemId], references: [id])

  @@index([userId])
  @@index([itemId])
  @@map("orders")
}
