# VK Mini App Settings
VK_APP_ID=51800000
VK_APP_SECRET=your_vk_mini_app_secret_key_here
# VK user IDs with admin access, as a JSON array, for example [123456,789012]
ADMIN_VK_IDS=[]

# Database Settings (PostgreSQL or SQLite)
DATABASE_URL=postgresql+psycopg2://lampa_user:lampa_password@localhost:5432/lampa_db
# For zero-setup local SQLite testing, use:
# DATABASE_URL=sqlite:///./lampa.db

# Environment
ENV=development
DEBUG=true
